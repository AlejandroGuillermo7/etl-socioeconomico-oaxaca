# Copiar este archivo como .env y llenar los datos reales. NO compartir el .env.
# Token del Banco de Indicadores: https://www.inegi.org.mx/servicios/api_indicadores.html
TOKEN_BISE=pega_aqui_tu_token_del_banco_de_indicadores
# Token del DENUE: https://www.inegi.org.mx/servicios/api_denue.html
TOKEN_DENUE=pega_aqui_tu_token_del_denue
# PostgreSQL en tu computadora (cambia TU_CONTRASENA por la de pgAdmin/PostgreSQL)
PG_URL=postgresql+psycopg2://postgres:TU_CONTRASENA@localhost:5432/oaxacaanalisis
# Si despues usan la instancia EC2, solo cambia localhost por la IP publica de la instancia
MONGO_URL=mongodb://localhost:27017
MONGO_DB=oaxacaanalisis
